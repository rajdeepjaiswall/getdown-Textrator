<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp" android:gravity="center_horizontal">
        <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_marginTop="32dp"
            android:src="@drawable/ic_logo" android:contentDescription="@string/app_name"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="Get Down Text Tractor" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/leaf_dark"/>
        <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center"
            android:text="Copy any text from any screen" android:textColor="@color/brown"/>
        <EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="28dp" android:background="@drawable/card_bg" android:paddingHorizontal="16dp"
            android:hint="Email" android:inputType="textEmailAddress" android:autofillHints="emailAddress"/>
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:background="@drawable/card_bg" android:paddingHorizontal="16dp"
            android:hint="Password (min 6 characters)" android:inputType="textPassword" android:autofillHints="password"/>
        <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="@color/brown_dark" android:visibility="gone"/>
        <Button android:id="@+id/primary" style="@style/Widget.Material3.Button"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp"
            android:text="Sign in"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="28dp" android:layout_height="28dp"
            android:layout_marginTop="10dp" android:visibility="gone"/>
        <Button android:id="@+id/toggle" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="New here? Create an account"/>
        <Button android:id="@+id/forgot" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Forgot password?" android:textColor="@color/brown"/>
        <Button android:id="@+id/guest" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp"
            android:text="Continue without login"/>
    </LinearLayout>
</ScrollView>
