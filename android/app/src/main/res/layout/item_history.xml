<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card_bg"
    android:layout_marginBottom="8dp" android:padding="14dp">
    <TextView android:id="@+id/text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="4" android:ellipsize="end" android:textColor="@color/ink" android:textSize="14sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/meta" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/pin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="Pin" android:textColor="@color/brown" android:textSize="12sp"/>
        <TextView android:id="@+id/copy" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="Copy" android:textStyle="bold" android:textColor="@color/leaf_dark" android:textSize="12sp"/>
        <TextView android:id="@+id/share" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="Share" android:textColor="@color/leaf_dark" android:textSize="12sp"/>
        <TextView android:id="@+id/delete" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="Delete" android:textColor="@color/danger" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
